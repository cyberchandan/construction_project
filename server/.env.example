# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/buildconnect_ncr

# JWT Authentication
JWT_SECRET=buildconnect_ncr_super_secure_jwt_secret_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# CORS Allowed Origin
CLIENT_ORIGIN=http://localhost:5173

# Initial Admin Credentials (used by npm run setup:admin)
INITIAL_ADMIN_NAME=Business Owner
INITIAL_ADMIN_EMAIL=admin@buildconnectncr.com
INITIAL_ADMIN_PASSWORD=Admin@BuildConnect2026

# Configurable Business Contact Defaults
BUSINESS_PHONE=+919810012345
BUSINESS_WHATSAPP=+919810012345
BUSINESS_EMAIL=contact@buildconnectncr.com

# Optional Email Notification Service (Leave blank to use console logger fallback)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
NOTIFICATION_EMAIL=owner@buildconnectncr.com

# Optional Cloudinary Configuration (Leave blank for fallback URL storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
